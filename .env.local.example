# Paystack — get these from the Paystack dashboard (Settings → API Keys & Webhooks)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Resend — get this from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain you've verified in Resend, or sends will fail.
RESEND_FROM_EMAIL="Oraya <hello@yourdomain.com>"

# Optional: Internal email to notify your team when someone pays so an operator can provision their account
TEAM_NOTIFICATION_EMAIL="admin@yourdomain.com"

# Optional: Persistent duplicate webhook replay prevention (Upstash Redis REST API)
# If omitted, falls back to server in-memory guard
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

